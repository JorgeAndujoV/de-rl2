.venv/
.claude/
__pycache__/
*.pyc
*.egg-info/
runs/

# Per-run experiment OUTPUTS are NOT tracked. They are regenerated on the cluster
# and retrieved via rsync (WSL is the source of truth). Tracking them made Nibi
# `git pull` abort — a job's freshly regenerated, still-untracked files collide
# with the committed copies. Only each experiment's config.yaml and
# experiments/REGISTRY.csv stay tracked. After adding these rules, drop the
# already-tracked copies from the index once with:
#   git ls-files -i -c --exclude-standard -z | xargs -0 -r git rm --cached
slurm_logs/
experiments/**/checkpoints/
experiments/**/trajectories/
experiments/**/eval/
experiments/**/training_log.csv
experiments/**/progress_log.csv
experiments/**/run_metadata.json
# Generated analysis figures (scripts/analyze_experiment.py).
tests/
# Baselines are generated per-experiment by each job (run_experiment.sh, via
# run_baseline --skip-existing); regenerable, rsync back if a local copy is wanted.
baselines/
*.bak.*
cec13-c-code/
cec13 python benchmark/
results/
scripts/MACHINERY.md
